---
interface Props {
  photo?: string;
}
const { photo = "/assets/photos/webp/photo_26.webp" } = Astro.props;
const style = `background-image: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('${photo}')`;
---

<section class="cta" style={style}>
  <div class="container">
    <h2>Working with dbt and want to start with conversational analytics?</h2>
    <a class="button" href="/contact">Send me a message</a>
  </div>
</section>
