---
import { talks } from "../data/site";

const related: Record<string, { href: string; label: string }> = {
  "bol-content-generation-at-scale": { href: "/cases/bol", label: "Read the bol case" },
  "winparts-data-ai-platform": { href: "/cases/winparts", label: "Read the Winparts case" },
  "conversational-analytics-demo": { href: "/conversational-analytics", label: "See the conversational analytics tool" },
};
---

<div class="talks">
  {
    talks.map((talk) => {
      const rel = talk.relatedProjectSlug ? related[talk.relatedProjectSlug] : undefined;
      return (
        <article class="card talk" id={talk.key}>
          <p class="card-meta">
            {talk.type === "podcast" ? "Podcast" : "Talk"} · {talk.event} · {talk.date}
            {talk.venue && ` · ${talk.venue}`}
          </p>
          <h2 lang={talk.titleLang}>{talk.title}</h2>
          {talk.speakers && talk.speakers.length > 0 && (
            <p class="talk-speakers">
              {talk.type === "podcast" ? "" : "With "}
              {talk.speakers.join(" · ")}
            </p>
          )}
          <p>{talk.description}</p>
          <p class="talk-links">
            <a class="text-link" href={talk.eventUrl} rel="noopener" target="_blank">
              Original page
            </a>
            {talk.links?.map((l) => (
              <a class="text-link" href={l.url} rel="noopener" target="_blank">
                {l.label}
              </a>
            ))}
            {rel && (
              <a class="text-link" href={rel.href}>
                {rel.label}
              </a>
            )}
          </p>
        </article>
      );
    })
  }
</div>
