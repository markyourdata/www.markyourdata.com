---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { site } from "../data/site";
---

<Base
  title="Contact"
  description="Get in touch with Mark Schep of Mark Your Data about conversational analytics, a data platform or a data and AI project."
>
  <Hero
    title="Get in touch"
    tagline="Let's discuss your data challenges and how we can help"
    photo="/assets/photos/webp/photo_29.webp"
  />

  <section>
    <div class="container contact">
      <div>
        <img class="contact-photo" src="/assets/photos/webp/photo_1.webp" alt="Mark Schep" />
        <p><strong>Mark Schep</strong><br />Founder</p>
        <p>
          Whether you need a data platform, strategic direction, or hands-on project support, I'm happy to discuss how we
          can help.
        </p>
        <p>Fill out the form and I'll get back to you.</p>
        <h3>Other ways to connect</h3>
        <p><a class="text-link" href={site.linkedin} rel="noopener" target="_blank">Connect on LinkedIn</a></p>
      </div>

      <form class="contact-form" action="https://formspree.io/f/mojvgzzn" method="POST">
        <div class="form-group">
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" required placeholder="Your full name" autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" placeholder="Your company name" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="phone">Phone (if you'd like a callback)</label>
          <input type="tel" id="phone" name="phone" placeholder="+31 6 1234 5678" autocomplete="tel" />
        </div>
        <div class="form-group">
          <label for="message">How can we help? *</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us about your data challenge or question..."
          ></textarea>
        </div>
        <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="New contact from Mark Your Data website" />
        <button type="submit" class="button">Send message</button>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;
    button.textContent = "Sending...";
    button.disabled = true;
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Form submission failed");
      window.location.href = "/thank-you";
    } catch {
      button.textContent = label;
      button.disabled = false;
      alert("There was a problem sending your message. Please try again or email us directly.");
    }
  });
</script>
