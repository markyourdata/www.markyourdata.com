---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Cta from "../../components/Cta.astro";
import { costHub as hub, lastReviewed } from "../../data/hubs";

const drivers = [
  {
    driver: "Hosting the application",
    drives: "An always-on service that receives the chat messages.",
    expect: "Under €100 a month at list price (estimate).",
    down: "It runs in your own cloud project.",
  },
  {
    driver: "LLM usage",
    drives: "Tokens per question and the model you choose.",
    expect:
      "With Gemini, under one cent per question on average, measured across our demo runs on sample data. It depends on the provider, models and task complexity.",
    down: "A fixed pipeline without an agent loop. Where a metric exists, the model picks it instead of writing SQL. Result rows go to the model only if you allow it. Routing can run on a small decision model. Cost per request is in the log, with a limit per request.",
  },
  {
    driver: "Database",
    drives: "The data scanned per query.",
    expect:
      "Your existing warehouse. Good data modelling, such as marts, partitioning and metrics on aggregated models, keeps it down.",
    down: "Read-only access. Governed answers run the SQL of the metrics your team reviewed. You can cap the data a query scans.",
  },
  {
    driver: "Licence",
    drives: "Mark Your Data.",
    expect: "Setup plus a yearly service, per organisation, priced after the POC.",
    down: "You decide after the POC, once you've seen it work on your own questions.",
  },
  {
    driver: "Maintenance time",
    drives: "Defining metrics and acting on gaps.",
    expect: "Depends on how fast your team closes gaps. The first pilot will measure it.",
    down: "The closed loop: the log shows which gaps users hit and why, and a fix is one dbt pull request, so you fix what users actually hit, once.",
  },
];

const genie = {
  text: "free for users through 31 January 2027",
  href: "https://docs.databricks.com/aws/en/genie/monitor-cost",
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: hub.qa.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Base title={hub.title} description={hub.description} jsonLd={faqJsonLd}>
  <Hero eyebrow="Conversational analytics" title={hub.title} />

  <section>
    <div class="container container--narrow">
      <p class="lead">{hub.summary}</p>
    </div>
    <div class="container prose">
      <h2>What drives the cost</h2>
      <table class="stack-table">
        <thead>
          <tr>
            <th scope="col">Cost driver</th>
            <th scope="col">What drives it</th>
            <th scope="col">What to expect</th>
            <th scope="col">How Mark Your Data Assistant keeps it down</th>
          </tr>
        </thead>
        <tbody>
          {
            drivers.map((row) => (
              <tr>
                <th scope="row">{row.driver}</th>
                <td data-label="What drives it">{row.drives}</td>
                <td data-label="What to expect">{row.expect}</td>
                <td data-label="How Mark Your Data Assistant keeps it down">{row.down}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section--gray">
    <div class="container container--narrow">
      <h2>Build the business case with your own numbers</h2>
      <p>Start with the time your team spends on ad-hoc questions today, using your own numbers. Then add:</p>
      <ul>
        <li><strong>Waiting time for the business:</strong> how long a question waits in the queue today. Answers took 3 to 8 seconds in testing on sample data.</li>
        <li><strong>Disputed numbers:</strong> measure the share of governed answers at the start, then every month.</li>
        <li><strong>Your dbt project:</strong> every closed gap is a definition your dashboards can use too.</li>
        <li><strong>The alternatives:</strong> compare building text-to-SQL yourself, a platform assistant and Mark Your Data Assistant on total cost, including who does the loop and how portable your definitions are.</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="container container--narrow">
      <h2>What it means for you</h2>
      <ul>
        {
          hub.roles.map((item) => (
            <li>
              <strong>{item.role}:</strong> {item.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--gray">
    <div class="container container--narrow">
      <h2>Questions and answers</h2>
      <div class="faq">
        {
          hub.qa.map((item) => {
            const parts = item.answer.split(genie.text);
            return (
              <details>
                <summary>{item.question}</summary>
                <p class="card-meta">{item.role}</p>
                <p>
                  {parts.length === 2 ? (
                    <>
                      {parts[0]}<a class="text-link" href={genie.href} rel="noopener">{genie.text}</a>{parts[1]}
                    </>
                  ) : (
                    item.answer
                  )}
                </p>
              </details>
            );
          })
        }
      </div>
      <p class="more-link">
        <a class="text-link" href="/demo">See the demo</a> or
        <a class="text-link" href="/conversational-analytics">read how Mark Your Data Assistant works</a>.
      </p>
      <p class="card-meta">Last reviewed: {lastReviewed}</p>
    </div>
  </section>

  <Cta />
</Base>
