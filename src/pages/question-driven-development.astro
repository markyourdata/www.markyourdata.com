---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Cta from "../components/Cta.astro";

const steps = [
  {
    title: "Begin with the question.",
    text: "The real questions colleagues ask in Teams, not a list written in advance.",
  },
  {
    title: "An unverified answer (⚠️) is the failing test.",
    text: "The question isn't covered by a governed definition in the semantic layer yet.",
  },
  {
    title: "The definition added in dbt makes it pass (✅).",
    text: "The data team adds a metric or saved query, reviewed like any other code change.",
  },
  {
    title: "The coverage scan is the test run.",
    text: "The scan asks every question on your list through Mark Your Data Assistant and reports each one as ✅ governed (with the metric used), ⚠️ unverified, ❓ asked back or ⛔ refused. Run the scan before and after a dbt change to see the difference per question.",
  },
];

const loop = [
  "Ask in Teams",
  "⚠️ Unverified",
  "👎 with a reason",
  "Data team adds the definition in dbt",
  "Publish",
  "✅ Governed for everyone",
  "The scan confirms coverage went up",
];
---

<Base
  title="Question-Driven Development"
  description="Question-Driven Development treats the questions your colleagues ask as a test suite for your dbt semantic layer: an unverified answer is a failing test, and a metric added in dbt makes it pass."
>
  <Hero
    title="Question-Driven Development"
    tagline="Treat your users' questions like a test suite for your semantic layer."
  />

  <section>
    <div class="container container--narrow">
      <p class="definition">
        Question-Driven Development is a way of working for dbt teams in which the questions colleagues actually ask act as
        the test suite for the semantic layer: an unverified answer is a failing test, and a metric or saved query added in
        dbt makes it pass.
      </p>
      <ol class="qdd-steps">
        {
          steps.map((step) => (
            <li>
              <strong>{step.title}</strong> {step.text}
            </li>
          ))
        }
      </ol>
      <p>The scan ends with a summary such as <code>Governed: 6 of 7 (before: 5 of 7)</code>.</p>
      <div class="note">
        <p>
          ✅ means “answered from your definition”, not “proven correct”. The data team checks correctness separately, with a
          set of reference questions and expected results that it maintains.
        </p>
      </div>
    </div>
  </section>

  <section class="section--gray">
    <div class="container container--narrow">
      <h2>Where the questions come from</h2>
      <p>
        The questions come from Teams. In a pilot, Mark Your Data Assistant runs on your own cloud and colleagues ask
        their real questions in Teams from the first day.
      </p>
      <p>
        The assistant's log shows every question, whether it was governed, and the 👎 reasons. The data team picks the
        unverified questions marked “Data is missing or incomplete” as the next definitions to add, and runs the coverage
        scan on the questions colleagues asked to see coverage go up after each dbt change.
      </p>
    </div>
  </section>

  <section>
    <div class="container container--narrow">
      <h2>The loop</h2>
      <ol class="loop">
        {loop.map((step) => <li>{step}</li>)}
      </ol>
      <p>
        The data team chooses the definitions and writes them. Mark Your Data Assistant labels the answers, collects the
        feedback and measures the coverage.
      </p>
      <p><a class="text-link" href="/conversational-analytics">See Mark Your Data Assistant</a></p>
    </div>
  </section>

  <Cta
    text="Start with a quickscan to see whether Mark Your Data Assistant fits your stack, or with a pilot on your own cloud."
  />
</Base>
