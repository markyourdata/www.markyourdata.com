---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Testimonials from "../../components/Testimonials.astro";
import Cta from "../../components/Cta.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { data } = service;

const reviews: Record<string, { intro?: string; keys: string[] }> = {
  strategy: {
    intro: "Reviews for Mark Schep and Berend Dumas, who host the offsite together.",
    keys: [
      "erick-webbe",
      "Christopher Marcks",
      "Lisette van de Steeg",
      "Frank de Gouw",
      "elmer-hiemstra",
      "Martin Schijf",
      "jasper-van-heijst",
      "Erick Webbe - Berend",
      "Benjamin van Vianen",
      "Daan van den Berg",
      "Richard Norbruis",
    ],
  },
  "data-engineering": { keys: ["Lisette van de Steeg", "jasper-van-heijst", "erick-webbe"] },
  "ai-engineering": { keys: ["Richard Norbruis", "Benjamin van Vianen", "elmer-hiemstra"] },
};
const review = reviews[service.id];
---

<Base title={data.title} description={data.description}>
  <Hero title={data.heroTitle} tagline={data.tagline} photo={data.photo} />

  <section>
    <div class="container prose">
      <Content />
    </div>
  </section>

  {
    review && (
      <section class="section--gray">
        <div class="container">
          <h2>What clients say</h2>
          {review.intro && <p class="section-intro">{review.intro}</p>}
          <Testimonials keys={review.keys} showAllLink={!review.intro} />
        </div>
      </section>
    )
  }

  <Cta
    heading={data.cta.heading}
    text={data.cta.text || undefined}
    button={data.cta.button}
    photo="/assets/photos/webp/photo_26.webp"
  />
</Base>
