---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CaseCard from "../../components/CaseCard.astro";
import Cta from "../../components/Cta.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection("cases")).sort((a, b) => a.id.localeCompare(b.id)).reverse();
---

<Base
  title="Data & AI services"
  description="Mark Your Data offers a Data & AI quickscan, a data platform on open-source tools and AI engineering on top of that platform, next to conversational analytics for dbt teams."
>
  <Hero
    title="Data & AI services"
    tagline="Strategy, platform and execution. We help you prove value fast, then scale what works."
    photo="/assets/photos/webp/photo_34.webp"
  />

  <section>
    <div class="container">
      <h2>How we help</h2>
      <p class="section-intro">
        We bring senior expertise to your data & AI challenges, whether you need strategic direction, a solid foundation,
        or hands-on delivery.
      </p>
      <div class="grid">
        {
          services.map((s) => (
            <a class="card card-link" href={`/services/${s.id}`}>
              <h3>{s.data.title}</h3>
              <p>{s.data.card}</p>
              <span class="text-link">Learn more</span>
            </a>
          ))
        }
        <a class="card card-link" href="/conversational-analytics">
          <h3>Conversational analytics</h3>
          <p>
            For dbt teams on BigQuery: the business asks questions in Microsoft Teams or Slack, and the data team sees which
            questions don't have a governed definition in dbt yet.
          </p>
          <span class="text-link">See the tool</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section--gray">
    <div class="container">
      <h2>Selected cases</h2>
      <div class="grid">
        {
          cases.map((c) => (
            <CaseCard href={`/cases/${c.id}`} client={c.data.client} logo={c.data.logo} title={c.data.title} text={c.data.intro} />
          ))
        }
      </div>
    </div>
  </section>

  <Cta heading="Let's talk about your data" button="Get in touch" photo="/assets/photos/webp/photo_26.webp" />
</Base>
