---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import CaseCard from "../../components/CaseCard.astro";
import Cta from "../../components/Cta.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection("cases")).sort((a, b) => a.id.localeCompare(b.id)).reverse();
---

<Base
  title="Data & AI services"
  description="Mark Your Data offers conversational analytics for dbt teams, data platforms, AI engineering at scale and data & AI strategy, from one person who has done all four jobs."
>
  <Hero
    title="Data & AI services"
    tagline="Conversational analytics, data platforms, AI engineering and strategy, from one person who has done all four jobs."
    photo="/assets/photos/webp/photo_34.webp"
  />

  <section>
    <div class="container">
      <p class="lead">
        Mark Your Data helps companies do more with data and AI, from the strategic question of where AI helps to the
        systems that run in production. Mark Schep has worked in data and AI since 2015, for more than 10 clients, as
        analyst, data scientist, data engineer and AI engineer.
      </p>
      <div class="grid grid--two">
        <a class="card card-link" href="/conversational-analytics">
          <h3>Conversational analytics</h3>
          <p>
            Mark Your Data Assistant: your team asks questions in Teams and gets answers from your dbt semantic
            layer.
          </p>
          <span class="text-link">See the tool</span>
        </a>
        {
          services.map((s) => (
            <a class="card card-link" href={`/services/${s.id}`}>
              <h3>{s.data.title}</h3>
              <p>{s.data.card}</p>
              <span class="text-link">Learn more</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--gray">
    <div class="container">
      <h2>Selected cases</h2>
      <div class="grid">
        {
          cases.map((c) => (
            <CaseCard href={`/cases/${c.id}`} client={c.data.client} logo={c.data.logo} title={c.data.title} text={c.data.intro} />
          ))
        }
      </div>
    </div>
  </section>

  <Cta heading="Not sure which service fits?" text="Plan a first conversation to see where an outside view helps." button="Send me a message" photo="/assets/photos/webp/photo_26.webp" />
</Base>
